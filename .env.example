# 复制为 .env 后填写；勿将含真实密钥的 .env 提交到版本库。
# MySQL 容器（与下方 SPF_DB_DSN 中的用户、密码、库名保持一致）
MYSQL_ROOT_PASSWORD=spf_root_change_me
MYSQL_DATABASE=spf

# 应用：MySQL DSN（主机名使用 compose 服务名 mysql）
SPF_DB_DSN=root:spf_root_change_me@tcp(mysql:3306)/spf?charset=utf8mb4&parseTime=true&loc=Local

# 应用：JWT 与加密（openssl rand -base64 32 生成加密密钥）
JWT_SECRET_CURRENT=change-me-to-a-long-random-string
SPF_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# 可选：默认管理员（首次启动）
# SPF_DEFAULT_ADMIN_USER=admin
# SPF_DEFAULT_ADMIN_PASS=admin123

# 可选：转发端口范围（须与 compose 端口映射一致）
# SPF_PORT_RANGE_MIN=30000
# SPF_PORT_RANGE_MAX=33000
