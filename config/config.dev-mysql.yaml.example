# 复制为 config.dev-mysql.yaml 后与 docker-compose.dev-mysql.yml 配套使用（勿提交含密钥的文件）
server:
  host: 127.0.0.1
  port: 18080

database:
  type: mysql
  mysql:
    dsn: root:spfdevroot@tcp(127.0.0.1:3306)/spf?charset=utf8mb4&parseTime=true&loc=Local

jwt:
  secret_current: "dev-jwt-secret-change-me-32chars-min!!"

encryption:
  # openssl rand -base64 32
  key: "MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="

port_range:
  min: 30000
  max: 33000
